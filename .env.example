# Скопируйте в .env и подставьте свои значения.
# Этот же файл compose передаёт в контейнер через env_file.

# --- Django ----------------------------------------------------------------
# Обязателен, когда DJANGO_DEBUG=False — иначе приложение не запустится.
# Сгенерировать:  python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=change-me-please
DJANGO_DEBUG=True

# Адреса, по которым открывают сайт. Если входят по IP — впишите IP сервера.
# Звёздочка годится только для разработки.
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Те же адреса, но со схемой и портом, если он не стандартный:
#   http://192.0.2.10        — вход по IP на 80 порту
#   https://library.example.ru — когда появится домен
DJANGO_CSRF_TRUSTED_ORIGINS=

DJANGO_TIME_ZONE=Europe/Moscow

# --- Docker ----------------------------------------------------------------
# База в отдельном контейнере рядом с приложением. С этой строкой достаточно
# обычного `docker compose up -d` — оба файла подхватятся сами.
# Закомментируйте, если база внешняя (на хосте или на другом сервере).
COMPOSE_FILE=docker-compose.yml:docker-compose.postgres.yml

# Где слушает сайт. 0.0.0.0:80 — вход по IP сервера напрямую.
# Если впереди появится nginx на хосте, поставьте WEB_BIND=127.0.0.1
WEB_BIND=0.0.0.0
WEB_PORT=80

# --- База ------------------------------------------------------------------
POSTGRES_DB=oy_system_db
POSTGRES_USER=postgres
# Порт смотрит в сеть — пароль должен быть настоящим, а не как в примере
POSTGRES_PASSWORD=0000
# Имя сервиса, если база в контейнере (его же подставляет compose);
# host.docker.internal — если база на самом сервере, но вне Docker
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Первая схема — где Django создаёт свои таблицы, дальше схемы с компонентами
POSTGRES_SCHEMA=oy_system,public

# Где база доступна снаружи. 0.0.0.0 — с других машин (для стороннего софта,
# который читает представление Parts). 127.0.0.1 — только с самого сервера
POSTGRES_BIND=0.0.0.0
POSTGRES_PORT_PUBLISHED=5432

# Кодировка и правило сортировки. Задаются один раз, при создании базы.
# Если исходная база жила с другим правилом, порядок строк в списках после
# переезда изменится — задайте то же, что было, ДО первого запуска
POSTGRES_INITDB_ARGS=--encoding=UTF8

# True, если у колонки id в таблицах компонентов нет DEFAULT/IDENTITY
COMPONENTS_ASSIGN_PK_MANUALLY=False

# Сколько секунд держать в кэше значения фильтров, счётчики главной и
# справочник списков. 0 — не кэшировать (если базу правят мимо сайта
# и результат нужно видеть сразу)
COMPONENTS_CACHE_SECONDS=300

# --- Продакшен -------------------------------------------------------------
# Общий кэш для всех работников gunicorn. Пусто — кэш в памяти процесса.
# В docker-compose.yml задаётся автоматически: redis://redis:6379/0
DJANGO_CACHE_URL=

# True, только если перед приложением стоит nginx/traefik и он терминирует
# https. При входе по IP напрямую — False
DJANGO_BEHIND_PROXY=False

# Куки только по https. При входе по http (по IP, без сертификата) должно
# быть False, иначе браузер их не сохранит и войти не получится
DJANGO_SECURE_COOKIES=False

# Рабочие процессы gunicorn и потоки в каждом. Соединений с базой они
# держат workers × threads — при небольшом лимите подключений в Postgres
# задайте оба числа явно (например 5 и 4).
# Потоков должно быть больше одного: с одним работник блокируется на
# соединении, которое открыли и ничего не прислали, и арбитр убивает его
# по таймауту — «WORKER TIMEOUT ... no URI read» в журнале.
GUNICORN_WORKERS=
GUNICORN_THREADS=4
# Импорт пачки BOM-файлов идёт дольше обычного запроса
GUNICORN_TIMEOUT=180

# Сколько секунд ждать базу при старте контейнера (0 — не ждать)
DJANGO_WAIT_FOR_DB=60
# Накатывать миграции при старте. Затрагивают только таблицы Django:
# 27 таблиц компонентов помечены managed = False
DJANGO_MIGRATE_ON_START=true
