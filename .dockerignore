# .env с паролями в образ не попадает: настройки приходят переменными
# окружения, а образ должен быть одинаковым для всех стендов
.env
*.env
!.env.example

.git
.gitignore
.venv
venv
__pycache__
*.py[cod]
*.egg-info

# собирается на сборке образа, из репозитория не берётся
staticfiles/

# локальное и временное
*.sqlite3
*.log
*.dump
*.zip
.idea
.vscode
.DS_Store

docker-compose*.yml
Dockerfile

# загруженные изображения плат: живут в томе, а не в репозитории
media/
