# Прямые зависимости проекта. Отсюда собирается requirements.txt:
#
#     uv pip compile requirements.in -o requirements.txt
#     # или:  pip-compile requirements.in
#
# Зачем два файла. Здесь — то, что мы выбрали сами, диапазонами. Там —
# результат разрешения со всеми косвенными зависимостями и точными
# версиями, одинаковый на машине разработчика, в CI и в образе. Без этого
# `docker build` сегодня и через месяц ставит разные версии, и «у меня
# работает» перестаёт что-либо значить.

Django>=6.1,<6.2
psycopg[binary]>=3.2
openpyxl>=3.1        # разбор BOM-файлов Excel
Pillow>=10.4         # изображения плат: проверка при загрузке и уменьшение
django-crispy-forms>=2.3   # одна разметка строки формы на весь проект;
                           # пакет шаблонов свой, templates/oy/

# продакшен (используются в Docker-образе):
gunicorn>=23.0       # рабочий сервер
whitenoise>=6.7      # раздача собранной статики из самого приложения
redis>=5.0           # общий кэш, если задан DJANGO_CACHE_URL
